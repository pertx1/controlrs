# Copia este archivo como .env.local (en tu ordenador) y pon los mismos valores en Vercel → Settings → Environment Variables.
# Ninguna clave se sube a git.

# MailerLite (emails): Integrations → API → Generate new token
MAILERLITE_API_KEY=
# IDs de los grupos de MailerLite (Subscribers → Groups → abre el grupo → el número de la URL)
ML_GRUPO_REGALO=
ML_GRUPO_GUIA=
ML_GRUPO_CREADORES=

# Resend (avisos de los formularios de servicios al Gmail de la marca): resend.com → API Keys
RESEND_API_KEY=
CONTACTO_EMAIL=

# Gumroad: enlace del producto cuando esté a la venta (si está vacío, la página muestra "apúntate al lanzamiento")
NEXT_PUBLIC_GUMROAD_URL=

# Datos legales (los de tu padre o tu madre, titular de la web)
NEXT_PUBLIC_TITULAR_NOMBRE=
NEXT_PUBLIC_TITULAR_NIF=
NEXT_PUBLIC_TITULAR_EMAIL=
